# ==============================================================
# ALMARFA EDUCATIONAL PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with real credentials to source control.
# ==============================================================

# --------------------------------------------------------------
# Google Gemini AI API Configuration
# --------------------------------------------------------------
# Required for any Gemini server-side processing
GEMINI_API_KEY=""

# --------------------------------------------------------------
# Server & Hosting URLs
# --------------------------------------------------------------
# Base URL where the backend / web app is served.
# In production on Cloud Run, this is automatically injected.
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# --------------------------------------------------------------
# Firebase Web Client Configuration
# Obtain these credentials from your Firebase Console (Project Settings > General > Web App)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIRESTORE_DATABASE_ID="(default)"

# --------------------------------------------------------------
# Video Streaming CDN (Bunny Stream / Cloudflare Stream)
# --------------------------------------------------------------
# Optional: Video library and signing key for encrypted, expiring playback tokens
BUNNY_SECURITY_KEY=""
BUNNY_LIBRARY_ID=""
VITE_BUNNY_SECURITY_KEY=""
VITE_BUNNY_LIBRARY_ID=""

# --------------------------------------------------------------
# Initial Database Bootstrap (Optional)
# If bootstrapping an empty database, use these values to configure initial accounts
# --------------------------------------------------------------
INITIAL_SUPER_ADMIN_PHONE="0500000000"
INITIAL_SUPER_ADMIN_PASSWORD="ChangeMeOnFirstLogin123!"
